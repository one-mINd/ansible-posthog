POSTHOG_APP_TAG={{ posthog_app_tag }}
DOMAIN={{ posthog_domain }}
REGISTRY_URL={{ posthog_registry_url }}
POSTHOG_SECRET={{ posthog_secret }}
ENCRYPTION_SALT_KEYS={{ posthog_encryption_salt_keys }}
BROWSERLESS_SECRET={{ posthog_browserless_secret }}
CADDY_HOST="http://:8000"
TLS_BLOCK=
CADDY_TLS_BLOCK=
{% if posthog_anthropic_api_key %}
ANTHROPIC_API_KEY={{ posthog_anthropic_api_key }}
{% endif %}
{% if posthog_openai_api_key %}
OPENAI_API_KEY={{ posthog_openai_api_key }}
{% endif %}
{% if posthog_use_staging_tls %}
TLS_BLOCK=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
